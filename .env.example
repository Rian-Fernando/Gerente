# Supabase (required for cloud sync + auth)
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Feedex feedback widget (optional). Get the public key from your project at
# https://feedex.rianfernando.com/dashboard
#
# Leave this unset locally: with no key, the widget is not embedded at all, so
# development never posts into the real feedback inbox.
#
# NEXT_PUBLIC_FEEDEX_KEY is also accepted, because that is what Feedex's docs
# name it — but that prefix means nothing to Vite, which only exposes VITE_* to
# client code. It works here only because the key is read during the build
# rather than at runtime. Prefer VITE_FEEDEX_KEY in a Vite project.
VITE_FEEDEX_KEY=pk_fdx_xxxxxxxxxxxxxxxxxxxxxxxx
